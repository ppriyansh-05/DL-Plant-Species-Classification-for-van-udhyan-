# ==============================================================================
# Van Udyan Plant AI — Environment Variables
# ==============================================================================
# Copy this file to .env (backend) or frontend/.env.local for local development.

# --- Backend Settings (FastAPI) ---
PORT=8000
LOCAL_MODEL_PATH=best_van_udyan_top15.keras
CLASS_MAPPING_PATH=class_mapping.json
METRICS_PATH=evaluation_summary.json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Supabase Storage Configuration (Optional, Server-side Only)
# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Service Role Key or Anon Key (Server-side ONLY)
SUPABASE_KEY=your-supabase-service-role-or-anon-key-here
# Supabase Storage Bucket Name (where best_van_udyan_top15.keras is stored)
SUPABASE_BUCKET=models
# Path inside the bucket
SUPABASE_MODEL_PATH=best_van_udyan_top15.keras

# --- Frontend Settings (React + Vite) ---
# When running locally with Vite proxy enabled, leave empty.
# In production, set to your deployed backend URL:
VITE_API_URL=http://localhost:8000
